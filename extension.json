{
    "identifier": "com.timetraveltoaster.parinfer",
    "name": "Parinfer",
    "organization": "Time Travel Toaster",
    "description": "Parinfer for Nova: keep parentheses and indentation in agreement while editing Lisp code (Clojure, Scheme, Fennel, …). Paren and Indent modes.",
    "version": "1.0.0",
    "categories": ["other"],
    "license": "MIT",
    "repository": "https://github.com/cap10morgan/parinfer.novaextension",
    "bugs": "https://github.com/cap10morgan/parinfer.novaextension/issues",
    "main": "main.js",
    "activationEvents": [
        "onLanguage:clojure",
        "onLanguage:clojurescript",
        "onLanguage:scheme",
        "onLanguage:lisp",
        "onLanguage:fennel"
    ],
    "config": [
        {
            "key": "parinfer.enabled",
            "title": "Enable Parinfer",
            "description": "Run Parinfer on Lisp files. Off by default — Parinfer significantly changes editing behavior.",
            "type": "boolean",
            "default": false
        },
        {
            "key": "parinfer.mode",
            "title": "Mode",
            "description": "Paren Mode preserves the parens you type and fixes indentation to match. Indent Mode infers parens from your indentation (it may add or remove close parens).",
            "type": "enum",
            "values": [
                ["paren", "Paren Mode"],
                ["indent", "Indent Mode"]
            ],
            "default": "paren"
        }
    ],
    "configWorkspace": [
        {
            "key": "parinfer.enabled",
            "title": "Enable Parinfer",
            "description": "Run Parinfer on Lisp files in this workspace.",
            "type": "enum",
            "values": [
                ["null", "Inherit from Global Settings"],
                ["true", "Enable"],
                ["false", "Disable"]
            ],
            "default": "null"
        },
        {
            "key": "parinfer.mode",
            "title": "Mode",
            "description": "Parinfer mode for this workspace. Overrides the global setting.",
            "type": "enum",
            "values": [
                ["null", "Inherit from Global Settings"],
                ["paren", "Paren Mode"],
                ["indent", "Indent Mode"]
            ],
            "default": "null"
        }
    ],
    "commands": {
        "editor": [
            {
                "title": "Parinfer: Toggle",
                "command": "parinfer.toggle"
            },
            {
                "title": "Parinfer: Use Paren Mode",
                "command": "parinfer.useParenMode"
            },
            {
                "title": "Parinfer: Use Indent Mode",
                "command": "parinfer.useIndentMode"
            }
        ]
    }
}
